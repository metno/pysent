#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks (scripts/session.sh start does it; with
# MODE=overlay, overlay/link.sh points it at overlay/hooks).
# With the commit-identity module (kit.config COMMIT_IDENTITY=yes): refuse an author outside the
# allowlist and strip AI attribution trailers. Where scripts/scan.py is installed (MODE=overlay): refuse
# a message that breaks the deny-list. Without either this hook lets every commit through.
set -euo pipefail
scripts="$(cd -P "$(dirname "$0")/.." && pwd -P)/scripts"   # <checkout>/scripts, or overlay/scripts
if [[ "yes" == yes ]]; then
  email=$(git var GIT_AUTHOR_IDENT | sed -E 's/.*<([^>]*)>.*/\1/')
  case "$email" in
    massimods@met.no|epiesasha@me.com) ;;
    *) echo "commit-msg: author <$email> is not allowed. Allowed: massimods@met.no, epiesasha@me.com" >&2
       echo "Run: git config user.name <you> && git config user.email <one of them>" >&2
       echo "(the setup machine uses Massimo Di Stefano <massimods@met.no>)" >&2
       exit 1;;
  esac
  tmp=$(mktemp)
  grep -viE '^[[:space:]]*(co-authored-by:.*(anthropic|claude|copilot)|claude-session:)|generated with \[?claude code|claude\.ai/code/session_' "$1" > "$tmp" || true
  awk '{ l[NR]=$0 } END { n=NR; while (n>0 && l[n] ~ /^[[:space:]]*$/) n--; for (i=1;i<=n;i++) print l[i] }' "$tmp" > "$1"
  rm -f "$tmp"
fi
if [[ -f "$scripts/scan.py" ]]; then
  if ! python3 "$scripts/scan.py" -q --label "commit message" --message "$1" >&2; then
    echo "commit-msg: refused: the message breaks the deny-list ($scripts/scan.py). Reword it: say what the change does, in its own words." >&2
    exit 1
  fi
fi
