__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ipynb_checkpoints/

# Notebook run outputs (the fixtures under tests/data/ ARE committed).
docs/notebooks/_output/
docs/notebooks/_qa_output/
executed/

# Local editor/tool state - never publish.
# Anchored to the repo root so these can never shadow a source directory of the
# same name (e.g. a future src/pysent/memory/).
# The session system's own files are committed: every session and every machine
# needs the same hooks and skills. What stays out is the personal and the
# transient - a machine's own override, and anything Claude Code writes itself.
/.claude/*
!/.claude/settings.json
!/.claude/skills/
/.claude/settings.local.json
/.cursor/
/.aider*
/AGENT/
/memory/
/scratchpad/

# Real Sentinel granules fetched for measurements: far too large to commit.
# The committed test windows live in tests/data/ instead.
.s5pdata/
